# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Sign in with Apple ---
# Apple Developer > Certificates, Identifiers & Profiles:
# 1. Register an App ID with the "Sign in with Apple" capability enabled.
# 2. Create a Services ID (this is your web client) — its identifier is APPLE_CLIENT_ID,
#    e.g. "com.floaliving.web". Configure it with:
#      - Domain: the domain this app is deployed on (not localhost)
#      - Return URL: https://<your-domain>/api/auth/apple/callback (must match APPLE_REDIRECT_URI exactly)
# 3. Under "Keys", create a new key with "Sign in with Apple" enabled and download the
#    AuthKey_XXXXXXXXXX.p8 file — you can only download it once.
#      - APPLE_KEY_ID is the 10-character key id shown next to it (also in the filename).
#      - APPLE_PRIVATE_KEY is the full contents of that .p8 file (keep the BEGIN/END lines,
#        replace real newlines with \n if your host requires a single-line env var).
# 4. APPLE_TEAM_ID is your 10-character Team ID, shown top-right of the Apple Developer portal.
APPLE_CLIENT_ID=com.floaliving.web
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://your-domain.com/api/auth/apple/callback

# --- Sign in with Google ---
# Google Cloud Console (console.cloud.google.com) > APIs & Services > Credentials:
# 1. Configure the "OAuth consent screen" (app name, support email, scopes: openid, email, profile).
# 2. Create Credentials > OAuth client ID > Application type: Web application.
#      - Authorized redirect URIs: must exactly match GOOGLE_REDIRECT_URI below, e.g.
#        http://localhost:3000/api/auth/google/callback for local dev, or
#        https://your-domain.com/api/auth/google/callback in production.
#        (Google, unlike Apple, allows http://localhost here — no tunnel needed to test.)
# 3. GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are shown once the client is created
#    (the secret can be regenerated later from the same screen if needed).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- App session ---
# Any long random string, used to sign the sign-in session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
